                    <li><a href="#"><i class="fa fa-truck fa-fw">
                        <div class="icon-bg bg-pink"></div>
                    </i><span class="menu-title">Operation</span><span class="fa arrow"></span></a>
                        <ul class="nav nav-second-level">
                            <% foreach (System.Data.DataRow row in dtOperacion.Rows)
