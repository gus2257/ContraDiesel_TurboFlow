            <div class="navLat">
                <ul id="side-menu" class="nav">
                     <%
                       
                          // if (dtOperacion.Rows.Count > 0 || dtReportes.Rows.Count > 0 || dtConfiguracion.Rows.Count > 0 || dtCatalogos.Rows.Count > 0 || dtGuard.Rows.Count > 0)
                           //{
                            %>

                    <li class="user-panel">
                        <div class="clearfix"></div>
                    </li>
                     <%if (dtOperacion.Rows.Count > 0)
