<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="masterGuardSimple.Master.cs" Inherits="WorkShop.include.masterGuardSimple" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
     <link rel="stylesheet" href="../css/font-awesome.min.css" />
    <link rel="icon" href="../images/logo.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

</head>
<body ng-app="app" ng-cloak>

    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-1.10.2.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-migrate-1.2.1.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-ui.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/bootstrap.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/bootstrap-hover-dropdown.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/html5shiv.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.metisMenu.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.slimscroll.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.cookie.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.menu.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.alerts.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/responsive-tabs.js"></script>

    <script type="text/javascript" src="<%=ruta %>js/scripts/json2.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jquery-ui-1.9.2.custom.min.js"></script>

    <script type="text/javascript" src="<%=ruta %>js/workshop/util.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/workshop/loader.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/workshop/main.js"></script>

    <script src="<%=ruta %>js/angular/angular.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/mask.js" type="text/javascript" ></script>
    <script src="<%=ruta %>js/angular/ngMask.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-masks-standalone.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-animate.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-bootstrap-multiselect.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-sanitize.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/smart-table.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angucomplete-alt.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/select.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-money-directive.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/customDirectives.js?V0002" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-disable.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angularjs-dropdown-multiselect.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ng-jsgrid.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/mainModule.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ivh-treeview.js" type="text/javascript"></script>

    <form id="form1" runat="server">
        <div ng-controller="AccesoController as acceso">
            <table width="100%">
                <tr>
                    <td>
                        <span id="NombreUsuario" runat="server"></span></b>   <span id="sizeScreen" class=" font-size: 15pt;"></span>px
                    </td>
                    <td>
                        Location
                        <asp:DropDownList runat="server" ID="ddlUbicacion" onchange="CambiaUbicacion(this);">
                        </asp:DropDownList>
                   </td>
                    <td>
                        <a onclick="SalirAp('<%=ruta%><%=login%>');" href="#">Log Out</a>
                    </td>
                </tr>
                <tr>
                    <td colspan="3">
                         <% foreach (System.Data.DataRow row in dtGuard.Rows)    { %>
                         <div class="col-sm-2 col-xs-2">
                             <a href="<%=ruta%><%= row["Ruta"]%>">
                                 <span class="submenu-title"><%= row["Nombre"]%></span>
                             </a>
                         </div>
                         <%  } %>
                          <%if (dtCatalogos.Rows.Count > 0 || dtConfiguracion.Rows.Count > 0 || dtOperacion.Rows.Count > 0 || dtReportes.Rows.Count > 0) { %>
                         <div class="col-sm-2 col-xs-2">
                             <a href="<%=ruta%>pages/Principal.aspx">
                                 <span class="submenu-title">Principal</span>
                             </a>
                         </div>
                         <%  } %>         

                    </td>
                </tr>
            </table>
      </div>

        
                <asp:ContentPlaceHolder ID="main" runat="server">
                </asp:ContentPlaceHolder>
  

  

        <script type="text/javascript" language="javascript" src="<%=ruta %>js/workshop/master.js"></script>
        <script type="text/javascript" language="javascript" src="<%=ruta %>js/workshop/acceso.js"></script>

    </form>
</body>
</html>
