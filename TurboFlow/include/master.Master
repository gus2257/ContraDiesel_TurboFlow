<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="master.master.cs" Inherits="WorkShop.include.master" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Turbo Flow</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
     <link rel="stylesheet" href="../css/font-awesome.min.css" />
    <link rel="icon" href="../images/logo.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body.estilo {
            font: 13px/20px 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-image: url("../../images/background.png");
            background-repeat: no-repeat;
            background-size: 100% 100%;
        }
    </style>
</head>
<body ng-app="app" ng-cloak class="estilo">
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-1.10.2.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jquery-ui-1.9.2.custom.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-migrate-1.2.1.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery-ui.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/bootstrap.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/bootstrap-hover-dropdown.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/html5shiv.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/respond.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.metisMenu.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.slimscroll.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.cookie.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/icheck.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/custom.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.notific8.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/highcharts.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.menu.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/holder.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/responsive-tabs.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.newsTicker.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/moment.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/nuevos/bootstrap-datepicker.min.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/json2.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/xml2json.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jquery.widgets.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jquery.formatCurrency-1.4.0.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jquery.formatCurrency.all.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/jquery/jquery.alerts.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/scripts/jQuery.MaskedInputs.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/workshop/util.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/workshop/loader.js"></script>
    <script type="text/javascript" src="<%=ruta %>js/workshop/main.js"></script>
  <%--  <script type="text/javascript" src="<%=ruta %>js/workshop/estandar.js"></script>--%>

    <script src="<%=ruta %>js/jsGrid/jsgrid.core.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jsGrid/jsgrid.load-indicator.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jsGrid/jsgrid.load-strategies.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jsGrid/jsgrid.sort-strategies.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jsGrid/jsgrid.field.js" type="text/javascript"></script>


    <script src="<%=ruta %>js/angular/angular.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="<%=ruta%>js/angular/mask.js"></script>
    <script type="text/javascript" src="<%=ruta%>js/angular/ngMask.js"></script>
    <script type="text/javascript" src="<%=ruta%>js/angular/angular-masks-standalone.js"></script>
    <script src="<%=ruta %>js/angular/angular-animate.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-bootstrap-multiselect.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-sanitize.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/smart-table.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/underscore.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angucomplete-alt.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/select.min.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-money-directive.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/customDirectives.js?V0002" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angular-disable.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/angularjs-dropdown-multiselect.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/multiselect.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ng-jsgrid.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ng-file-upload-shim.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ng-file-upload.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/mainModule.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/angular/ivh-treeview.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jquery/jquery.mixitup.js" type="text/javascript"></script>
    <script src="<%=ruta %>js/jquery/lightbox.min.js" type="text/javascript"></script>

    <form id="form1" runat="server">
        <div ng-controller="AccesoController as acceso">
            <!--BEGIN BACK TO TOP-->
            <a id="totop" href="#"><i class="fa fa-angle-up"></i></a>
            <!--END BACK TO TOP-->
            <!--BEGIN TOPBAR-->
            <table style="width:100%; height:70px;">
                <tr style="height:58px">
                    <td style="text-align:left; width:20%">
                           &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <img class="hidden-xs" alt="" src="<%=ruta%>/images/logo.webp" style="width:150px; object-fit:contain;"  />
                    </td>
                    <td style="text-align:center; font-size:30px; font-weight:bold;">
                        Turbo Flow
                        <br /><br />
                    </td>
                    <td style="text-align:right; width:20%">
                            <b>  <span id="NombreUsuario" runat="server" class="hidden-xs"></span></b>  
                            &nbsp;&nbsp;
                         <a href="../menus/main.aspx"><i class="fa fa-bars" style="font-size: 25px"></i></a>
                         <a id="logout" onclick="SalirAp('<%=ruta%><%=login%>');" href="#"><i class="fa fa-sign-out" style="font-size: 25px"></i></a>
                    </td>
                </tr>
                <tr style="height:6px">
                    <td style="font-size:3px; background-color:#C83421;" colspan="3"></td>
                </tr>
                <tr style="height:6px">
                    <td style="font-size:1px; background-color:#000000;" colspan="3"></td>
                </tr>
            </table>
            <!--END TOPBAR-->
                
            <table style="width:100%;" align="center">
                <tr>
                    <td>
                        <div>
                            <asp:ContentPlaceHolder ID="main" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </td>
                </tr>
            </table>
                    

         </div>


        <script type="text/javascript" language="javascript" src="<%=ruta %>js/workshop/acceso.js"></script>

    </form>
</body>
</html>
