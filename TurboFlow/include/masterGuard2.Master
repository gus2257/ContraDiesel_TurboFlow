    <form id="form1" runat="server">
        <div ng-controller="AccesoController as acceso">
           <div class="container-fluid">
                <div class="row">
                <div class="col-sm-2">
                       <img class="hidden-xs" alt="" src="<%=ruta%>/images/logo.png" />
                 </div>
                <div class="col-sm-4">
                     <span class="h2 hidden-xs">Rapid Transport Fleet Management</span>
                 </div>
                  <div class="col-sm-6">
                        <b>  <span id="NombreUsuario" runat="server"></span></b>  &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                         <%--  <br />
                            <div style="margin-top: 5px;">--%>
                            <span style="margin-top:-10px">Location
                                        <asp:DropDownList runat="server" ID="ddlUbicacion" onchange="CambiaUbicacion(this);">
                                        </asp:DropDownList>
                            </span>&nbsp;&nbsp;
                            <a onclick="SalirAp('<%=ruta%><%=login%>');" href="#">Log Out</a>
                  </div>
                 </div> 
                <div class="row">
                        <% foreach (System.Data.DataRow row in dtGuard.Rows)    { %>
                        <div class="col-sm-2 col-xs-2">
                            <a href="<%=ruta%><%= row["Ruta"]%>">
                                <span class="submenu-title"><%= row["Nombre"]%></span>
                            </a>
                        </div>
                        <%  } %>
                         <%if (dtCatalogos.Rows.Count > 0 || dtConfiguracion.Rows.Count > 0 || dtOperacion.Rows.Count > 0 || dtReportes.Rows.Count > 0) { %>
                        <div class="col-sm-2 col-xs-2">
                            <a href="<%=ruta%>pages/Principal.aspx">
                                <span class="submenu-title">Principal</span>
                            </a>
                        </div>
                        <%  } %>                       
                </div>
          
            </div>

            <div>
                <asp:ContentPlaceHolder ID="main" runat="server">
                </asp:ContentPlaceHolder>
            </div>
    
      </div>
  

        <script type="text/javascript" language="javascript" src="<%=ruta %>js/workshop/master.js"></script>
        <script type="text/javascript" language="javascript" src="<%=ruta %>js/workshop/acceso.js"></script>

    </form>
</body>
</html>
